                <constraint firstItem="card-view" firstAttribute="trailing" secondItem="root-view" secondAttribute="trailing" id="card-trail"/>
                <constraint firstItem="header-view" firstAttribute="height" constant="260" id="hdr-h"/>
                <constraint firstItem="header-view" firstAttribute="leading" secondItem="root-view" secondAttribute="leading" id="hdr-lead"/>
                <constraint firstItem="header-view" firstAttribute="top" secondItem="root-view" secondAttribute="top" id="hdr-top"/>
                <constraint firstItem="header-view" firstAttribute="trailing" secondItem="root-view" secondAttribute="trailing" id="hdr-trail"/>
