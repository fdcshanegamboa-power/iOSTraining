                        <constraint firstItem="form-stack" firstAttribute="top" secondItem="subtitle-lbl" secondAttribute="bottom" constant="16" id="form-top"/>
                        <constraint firstItem="form-stack" firstAttribute="trailing" secondItem="card-view" secondAttribute="trailing" constant="-24" id="form-trail"/>
                        <constraint firstItem="login-btn" firstAttribute="leading" secondItem="card-view" secondAttribute="leading" constant="24" id="login-lead"/>
                        <constraint firstItem="login-btn" firstAttribute="top" secondItem="form-stack" secondAttribute="bottom" constant="20" id="login-top"/>
                        <constraint firstItem="login-btn" firstAttribute="trailing" secondItem="card-view" secondAttribute="trailing" constant="-24" id="login-trail"/>
                        <constraint firstItem="register-btn" firstAttribute="leading" secondItem="card-view" secondAttribute="leading" constant="24" id="reg-lead"/>
                        <constraint firstItem="register-btn" firstAttribute="top" secondItem="login-btn" secondAttribute="bottom" constant="20" id="reg-top"/>
                        <constraint firstItem="register-btn" firstAttribute="trailing" secondItem="card-view" secondAttribute="trailing" constant="-24" id="reg-trail"/>
                        <constraint firstItem="subtitle-lbl" firstAttribute="leading" secondItem="card-view" secondAttribute="leading" constant="24" id="sub-lead"/>
                        <constraint firstItem="subtitle-lbl" firstAttribute="top" secondItem="title-lbl" secondAttribute="bottom" constant="6" id="sub-top"/>
                        <constraint firstItem="subtitle-lbl" firstAttribute="trailing" secondItem="card-view" secondAttribute="trailing" constant="-24" id="sub-trail"/>
                        <constraint firstItem="title-lbl" firstAttribute="leading" secondItem="card-view" secondAttribute="leading" constant="24" id="title-lead"/>
                        <constraint firstItem="title-lbl" firstAttribute="top" secondItem="card-view" secondAttribute="top" constant="28" id="title-top"/>
                        <constraint firstItem="title-lbl" firstAttribute="trailing" secondItem="card-view" secondAttribute="trailing" constant="-24" id="title-trail"/>
